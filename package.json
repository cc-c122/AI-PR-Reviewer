{
  "name": "ai-pr-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted GitHub pull request review tool.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-pr-reviewer/api --filter @ai-pr-reviewer/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "render:build": "pnpm prisma:generate && pnpm build",
    "render:start": "prisma migrate deploy || node scripts/apply-sqlite-schema.mjs && pnpm --filter @ai-pr-reviewer/api start",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
